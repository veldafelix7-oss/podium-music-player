<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Remote playback (YOUTUBE_MUSIC_ARCHITECTURE.md §8): the system binds this listener only
             after the listener grants Podium notification access. Podium uses that grant for one
             thing — seeing and controlling the music app's media session. The service reads no
             notifications at all. -->
                <service
            android:name="app.podium.player.remote.MediaSessionAccessService"
            tools:node="remove" />
    </application>
</manifest>
